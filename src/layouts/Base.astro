---
import '@fontsource/gloock/400.css';
import '@fontsource-variable/hanken-grotesk/wght.css';
import '@fontsource-variable/rethink-sans/wght.css';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource-variable/antonio/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { negocio, semana } from '../data/negocio.ts';

// imagen: la que se ve al compartir la página; jsonLd: datos de schema.org de la página, junto al del local; articulo: og:type article
interface Props { titulo?: string; descripcion?: string; imagen?: string; jsonLd?: Record<string, unknown>[]; articulo?: boolean }
const {
  titulo,
  descripcion = 'Foto carnet, revelado de rollos, restauración, impresión y enmarcado en Talagante. Av. Bernardo O’Higgins 997.',
  imagen,
  jsonLd: extra = [],
  articulo = false,
} = Astro.props;
const tituloCompleto = titulo ? `${titulo} | ${negocio.nombre}` : `${negocio.nombre}, laboratorio fotográfico en Talagante`;
const canonica = new URL(Astro.url.pathname, Astro.site);

const diasSchema = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const tienda = {
  '@type': 'Store',
  '@id': new URL('/#local', Astro.site).href,
  name: negocio.nombre,
  url: Astro.site?.href,
  logo: new URL('/icon-512.png', Astro.site).href,
  image: new URL('/img/compartir.png', Astro.site).href,
  telephone: negocio.movil,
  email: negocio.email,
  address: { '@type': 'PostalAddress', streetAddress: negocio.direccion, addressLocality: negocio.ciudad, addressRegion: 'Región Metropolitana', postalCode: negocio.codigoPostal, addressCountry: 'CL' },
  sameAs: [negocio.instagram],
  openingHoursSpecification: Object.entries(semana).flatMap(([d, tramos]) =>
    tramos.map(([opens, closes]) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: diasSchema[Number(d)], opens, closes })),
  ),
};
const jsonLd = { '@context': 'https://schema.org', '@graph': [tienda, ...extra] };
const imagenCompartir = new URL(imagen ?? '/img/compartir.png', Astro.site);
---
<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try { const t = localStorage.getItem('tema'); if (['bn', 'cine', '110'].includes(t)) document.documentElement.dataset.theme = t; } catch {}
      // Animación (motion.css): solo sin reducción de movimiento; la luz roja, solo en la primera página de la sesión
      if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        const h = document.documentElement;
        h.classList.add('anim');
        try { if (!sessionStorage.getItem('revelado')) { h.classList.add('primera'); sessionStorage.setItem('revelado', '1'); } } catch {}
      }
    </script>
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content={articulo ? 'article' : 'website'} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenCompartir} />
    {!imagen && <meta property="og:image:width" content="1080" />}
    {!imagen && <meta property="og:image:height" content="1080" />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <div class="cortina" aria-hidden="true"><span>Revelando…</span></div>
    <div class="grano" aria-hidden="true"></div>
    <script>import '../scripts/motion.ts';</script>
  </body>
</html>
