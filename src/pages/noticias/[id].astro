---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Fecha from '../../components/Fecha.astro';

export async function getStaticPaths() {
  return (await getCollection('noticias')).map((nota) => ({ params: { id: nota.id }, props: { nota } }));
}
const { nota } = Astro.props;
const { Content } = await render(nota);
const jsonLd = [{
  '@type': 'Article', headline: nota.data.titulo, description: nota.data.resumen, datePublished: nota.data.fecha.toISOString().slice(0, 10),
  url: new URL(Astro.url.pathname, Astro.site).href, publisher: { '@id': new URL('/#local', Astro.site).href },
}];
---
<Base titulo={nota.data.titulo} descripcion={nota.data.resumen} jsonLd={jsonLd} articulo>
  <article class="container">
    <header class="pagina-cabeza">
      <p class="meta"><a class="enlace" href="/noticias/">Noticias</a> / <Fecha fecha={nota.data.fecha} /></p>
      <h1>{nota.data.titulo}</h1>
      <p class="lead">{nota.data.resumen}</p>
    </header>
    <div class="prosa"><Content /></div>
    {nota.data.fuente && (
      <p class="meta">Fuente: <a class="enlace" href={nota.data.fuente.url} rel="noopener">{nota.data.fuente.nombre}</a></p>
    )}
  </article>
</Base>
