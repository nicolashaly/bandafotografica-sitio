---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Fecha from '../../components/Fecha.astro';

const notas = (await getCollection('noticias')).sort((a, b) => +b.data.fecha - +a.data.fecha);
---
<Base titulo="Noticias de fotografía" descripcion="Consejos y novedades sobre fotografía, rollos e impresión desde Banda Fotográfica, Talagante.">
  <section class="pagina-cabeza container">
    <h1>Noticias y notas del laboratorio</h1>
    <p class="lead">Novedades de fotografía y trámites, y consejos para cuidar tus fotos y volver al rollo.</p>
  </section>
  <section class="seccion container">
    <ul class="notas">
      {notas.map((n) => (
        <li class="nota">
          <Fecha class="meta" fecha={n.data.fecha} />
          <h3><a href={`/noticias/${n.id}/`}>{n.data.titulo}</a></h3>
          <p>{n.data.resumen}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
